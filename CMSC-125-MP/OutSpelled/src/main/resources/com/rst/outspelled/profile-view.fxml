<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import java.net.URL?>

<VBox xmlns="http://javafx.com/javafx"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.rst.outspelled.ui.ProfileController"
      alignment="TOP_CENTER"
      spacing="0"
      styleClass="profile-root"
      prefWidth="900"
      prefHeight="650">

    <stylesheets>
        <URL value="@../../../assets/style.css" />
    </stylesheets>

    <!-- TOP TITLE -->
    <VBox alignment="CENTER" spacing="4" style="-fx-padding: 26 0 50 0;">
        <Label text="OutSpelled"
               styleClass="pixel-font"
               style="-fx-font-size: 86px;
                      -fx-font-weight: bold;
                      -fx-text-fill: #e2b96f;
                      -fx-effect: dropshadow(three-pass-box, #000000, 14, 0.9, 0, 3);" />
        <Label text="— Choose Your Wizard —"
               styleClass="pixel-font"
               style="-fx-font-size: 20px;
                      -fx-text-fill: #8899aa;
                      -fx-effect: dropshadow(three-pass-box, #000000, 6, 0.8, 0, 2);" />
    </VBox>

    <!-- Profile Cards -->
    <HBox fx:id="profileSlotsBox"
          alignment="CENTER"
          spacing="40"
          VBox.vgrow="NEVER" />

    <!-- Status -->
 <VBox alignment="CENTER"
      spacing="2"
      style="-fx-padding: 35 0 0 0;">

    <Label fx:id="statusLabel" text=""
           styleClass="pixel-font"
           style="-fx-font-size: 13px;
                  -fx-text-fill: #a0a0c0;
                  -fx-min-width: 400px; -fx-pref-width: 400px; -fx-max-width: 400px;
                  -fx-min-height: 24px; -fx-pref-height: 24px; -fx-max-height: 24px;
                  -fx-alignment: center;" />

    <VBox fx:id="playButtonContainer"
          alignment="CENTER"
          style="-fx-padding: 8 0 28 0;" />

</VBox>

</VBox>

