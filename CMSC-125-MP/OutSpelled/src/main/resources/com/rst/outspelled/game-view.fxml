<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.shape.*?>
<?import java.net.URL?>

<StackPane xmlns="http://javafx.com/javafx"
           xmlns:fx="http://javafx.com/fxml"
           fx:controller="com.rst.outspelled.ui.GameController"
           prefWidth="900"
           prefHeight="650">

    <stylesheets>
        <URL value="@../../../assets/style.css"/>
    </stylesheets>

    <!-- Main Game Screen -->
    <BorderPane fx:id="gameRoot" style="-fx-background-color: #1a1a2e;">

        <!-- TOP: HP Bars + Options -->
        <top>
            <VBox style="-fx-background-color: transparent;" alignment="CENTER">

                <!-- Options Row -->
                <HBox alignment="CENTER_RIGHT"
                      style="-fx-padding: 4 12 0 12;">
                    <Button text="⚙" onAction="#onOptionsClicked"
                            style="-fx-background-color: transparent;
                                   -fx-text-fill: #a0a0c0;
                                   -fx-font-size: 18px;
                                   -fx-cursor: hand;
                                   -fx-padding: 2 6 2 6;"/>
                </HBox>

                <!-- HP + Timer Row -->
                <HBox alignment="CENTER" spacing="20"
                      style="-fx-background-color: transparent; -fx-padding: 4 70 10 70;">

                    <!-- Player 1 HP -->
                    <VBox alignment="CENTER_LEFT" spacing="3" HBox.hgrow="ALWAYS">
                        <Label fx:id="player1NameLabel" text="Player 1"
                               styleClass="pixel-font"
                               style="-fx-text-fill: #e2b96f;
                                      -fx-font-size: 18px;
                                      -fx-font-weight: bold;
                                      -fx-effect: dropshadow(one-pass-box, rgba(0,0,0,0.95), 0, 0.0, 2, 2);"/>
                        <ProgressBar fx:id="player1HpBar" progress="1.0"
                                     prefWidth="370" prefHeight="32"
                                     styleClass="progress-bar pixel-hp-bar pixel-hp-p1"/>
                        <Label fx:id="player1HpLabel" text="200 / 200"
                               styleClass="pixel-font"
                               style="-fx-text-fill: #a0a0c0; -fx-font-size: 14px; -fx-font-weight: bold; -fx-effect: dropshadow(one-pass-box, rgba(0,0,0,0.8), 0, 0.0, 1, 1);"/>
                    </VBox>

                    <!-- Timer Center -->
                    <VBox alignment="CENTER" spacing="1" minWidth="90">
                        <Label text="⏳" style="-fx-font-size: 12px;"/>
                        <Label fx:id="timerLabel" text="30"
                               styleClass="pixel-font"
                               style="-fx-text-fill: #e2b96f;
                                      -fx-font-size: 42px;
                                      -fx-font-weight: bold;
                                      -fx-effect: dropshadow(one-pass-box, rgba(0,0,0,0.9), 0, 0.0, 1, 2);"/>
                        <Label fx:id="turnLabel" text="Player 1's Turn"
                               styleClass="pixel-font"
                               style="-fx-text-fill: #a0a0c0; -fx-font-size: 10px;
                                      -fx-effect: dropshadow(one-pass-box, rgba(0,0,0,0.8), 0, 0.0, 1, 1);"/>
                    </VBox>

                    <!-- Player 2 HP -->
                    <VBox alignment="CENTER_RIGHT" spacing="3" HBox.hgrow="ALWAYS">
                        <Label fx:id="player2NameLabel" text="Player 2"
                               styleClass="pixel-font"
                               style="-fx-text-fill: #7eb8e2;
                                      -fx-font-size: 18px;
                                      -fx-font-weight: bold;
                                      -fx-effect: dropshadow(one-pass-box, rgba(0,0,0,0.95), 0, 0.0, 2, 2);"/>
                        <ProgressBar fx:id="player2HpBar" progress="1.0"
                                     prefWidth="370" prefHeight="32"
                                     scaleX="-1"
                                     styleClass="progress-bar pixel-hp-bar pixel-hp-p2"/>
                        <Label fx:id="player2HpLabel" text="200 / 200"
                               styleClass="pixel-font"
                               style="-fx-text-fill: #a0a0c0; -fx-font-size: 14px; -fx-font-weight: bold; -fx-effect: dropshadow(one-pass-box, rgba(0,0,0,0.8), 0, 0.0, 1, 1);"/>
                    </VBox>

                </HBox>

                <!-- Centered Flat Battle Log (Displays only latest action) -->
                <ListView fx:id="battleLog"
                          prefWidth="700" prefHeight="38"
                          minWidth="700" minHeight="38"
                          maxWidth="700" maxHeight="38"
                          mouseTransparent="true"
                          focusTraversable="false"
                          styleClass="battle-log-flat">
                    <VBox.margin>
                        <Insets top="20" bottom="5"/>
                    </VBox.margin>
                </ListView>

            </VBox>
        </top>

        <!-- CENTER: Arena -->
        <center>
            <HBox alignment="CENTER" spacing="10"
                  style="-fx-padding: 10;">

                <!-- Player 1 Wizard -->
                <VBox alignment="BOTTOM_CENTER" spacing="8" prefWidth="180">
                    <padding>
                        <Insets top="4" right="4" bottom="4" left="4"/>
                    </padding>
                    <StackPane fx:id="wizard1Portrait" prefWidth="120" prefHeight="160"
                               style="-fx-border-color: #444466; -fx-border-width: 1.5; -fx-border-radius: 6; -fx-background-radius: 6; -fx-background-color: #2a1a4a;"/>
                    <Label fx:id="wizard1NameTag" text="🧙 Wizard 1"
                           style="-fx-text-fill: #e2b96f; -fx-font-size: 12px;"/>
                </VBox>

                <!-- Center: Grid + Word + Buttons -->
                <VBox alignment="CENTER" spacing="10" HBox.hgrow="ALWAYS">

                    <Label fx:id="skillCheckStatusLabel" text=""
                           style="-fx-text-fill: #ff6b6b;
                                  -fx-font-size: 13px;
                                  -fx-font-weight: bold;"/>

                    <GridPane fx:id="letterGridPane"
                              alignment="CENTER"
                              hgap="6" vgap="6">
                        <padding>
                            <Insets top="5" bottom="5" left="5" right="5"/>
                        </padding>
                    </GridPane>

                    <HBox alignment="CENTER" spacing="5">
                        <Label text="Spell:"
                               style="-fx-text-fill: #a0a0c0; -fx-font-size: 13px;"/>
                        <Label fx:id="selectedWordLabel" text="_ _ _"
                               style="-fx-text-fill: #e2b96f;
                                      -fx-font-size: 20px;
                                      -fx-font-weight: bold;
                                      -fx-font-family: 'Pixelify Sans';"/>
                    </HBox>

                    <Label fx:id="feedbackLabel" text=""
                           style="-fx-font-size: 12px; -fx-text-fill: #a0a0c0;"/>

                    <HBox alignment="CENTER" spacing="10">
                        <Button fx:id="castButton" text="✨ Cast!"
                                onAction="#onCastClicked"
                                style="-fx-background-color: #e2b96f;
                                       -fx-text-fill: #1a1a2e;
                                       -fx-font-size: 14px;
                                       -fx-font-weight: bold;
                                       -fx-padding: 10 25 10 25;
                                       -fx-background-radius: 6;
                                       -fx-cursor: hand;"/>
                        <Button text="↺ Clear"
                                onAction="#onClearClicked"
                                style="-fx-background-color: transparent;
                                       -fx-text-fill: #a0a0c0;
                                       -fx-font-size: 13px;
                                       -fx-border-color: #a0a0c0;
                                       -fx-border-radius: 5;
                                       -fx-padding: 8 18 8 18;
                                       -fx-cursor: hand;"/>
                        <Button text="🔀 Shuffle (Space)"
                                onAction="#onShuffleClicked"
                                style="-fx-background-color: transparent;
                                       -fx-text-fill: #a0a0c0;
                                       -fx-font-size: 13px;
                                       -fx-border-color: #a0a0c0;
                                       -fx-border-radius: 5;
                                       -fx-padding: 8 18 8 18;
                                       -fx-cursor: hand;"/>
                    </HBox>



                </VBox>

                <!-- Player 2 Wizard -->
                <VBox alignment="BOTTOM_CENTER" spacing="8" prefWidth="180">
                    <padding>
                        <Insets top="4" right="4" bottom="4" left="4"/>
                    </padding>
                    <StackPane fx:id="wizard2Portrait" prefWidth="120" prefHeight="160"
                               style="-fx-border-color: #444466; -fx-border-width: 1.5; -fx-border-radius: 6; -fx-background-radius: 6; -fx-background-color: #1a2a4a;"/>
                    <Label fx:id="wizard2NameTag" text="🧙 Wizard 2"
                           style="-fx-text-fill: #7eb8e2; -fx-font-size: 12px;"/>
                </VBox>

            </HBox>
        </center>

    </BorderPane>

    <!-- Last Stand Overlay -->
    <StackPane fx:id="lastStandOverlay"
               visible="false"
               style="-fx-background-color: #000000;"
               opacity="0.88">

        <VBox alignment="CENTER" spacing="20"
              style="-fx-padding: 40;">

            <Label text="⚠ LAST STAND ⚠"
                   style="-fx-text-fill: #ff6b6b;
                          -fx-font-size: 32px;
                          -fx-font-weight: bold;
                          -fx-font-family: 'Pixelify Sans';"/>

            <Label text="Unscramble the word to survive!"
                   style="-fx-text-fill: #a0a0c0; -fx-font-size: 14px;"/>

            <Label fx:id="scrambledWordLabel" text="??????"
                   style="-fx-text-fill: #e2b96f;
                          -fx-font-size: 48px;
                          -fx-font-weight: bold;
                          -fx-font-family: 'Pixelify Sans';"/>

            <Label fx:id="lastStandTimerLabel" text="15"
                   style="-fx-text-fill: #ff6b6b;
                          -fx-font-size: 28px;
                          -fx-font-weight: bold;"/>

            <TextField fx:id="lastStandInput"
                       promptText="Type the unscrambled word..."
                       prefWidth="320"
                       style="-fx-background-color: #2a2a4a;
                              -fx-text-fill: white;
                              -fx-prompt-text-fill: #666688;
                              -fx-border-color: #e2b96f;
                              -fx-border-radius: 5;
                              -fx-background-radius: 5;
                              -fx-font-size: 20px;
                              -fx-padding: 10;"/>

            <Label fx:id="lastStandFeedbackLabel" text=""
                   style="-fx-font-size: 13px; -fx-text-fill: #a0a0c0;"/>

        </VBox>
    </StackPane>

</StackPane