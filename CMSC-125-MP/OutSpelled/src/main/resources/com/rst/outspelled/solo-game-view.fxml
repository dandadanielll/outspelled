<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.shape.*?>
<?import java.net.URL?>

<!-- Identical layout to game-view.fxml; only the controller attribute is different -->
<StackPane xmlns="http://javafx.com/javafx"
           xmlns:fx="http://javafx.com/fxml"
           fx:controller="com.rst.outspelled.ui.SoloGameController"
           prefWidth="900"
           prefHeight="650">

    <stylesheets>
        <URL value="@../../../assets/style.css"/>
    </stylesheets>

    <!-- Main Game Screen -->
    <BorderPane fx:id="gameRoot" style="-fx-background-color: #1a1a2e;">

        <!-- TOP: HP Bars + Options (transparent header) -->
        <top>
            <VBox style="-fx-background-color: transparent;" alignment="CENTER">

                <!-- Options Row -->
                <HBox alignment="CENTER_RIGHT"
                      style="-fx-padding: 4 12 0 12; -fx-background-color: transparent;">
                    <Button text="⚙" onAction="#onOptionsClicked"
                            style="-fx-background-color: transparent;
                                   -fx-text-fill: #a0a0c0;
                                   -fx-font-size: 18px;
                                   -fx-cursor: hand;
                                   -fx-padding: 2 6 2 6;"/>
                </HBox>

                <!-- HP + Timer Row -->
                <HBox alignment="CENTER" spacing="20"
                      style="-fx-background-color: transparent; -fx-padding: 4 70 10 70;">

                    <!-- Player HP -->
                    <VBox alignment="CENTER_LEFT" spacing="3" HBox.hgrow="ALWAYS">
                        <Label fx:id="player1NameLabel" text="Player"
                               styleClass="pixel-font"
                               style="-fx-text-fill: #e2b96f;
                                      -fx-font-size: 18px;
                                      -fx-font-weight: bold;
                                      -fx-effect: dropshadow(one-pass-box, rgba(0,0,0,0.95), 0, 0.0, 2, 2);"/>
                        <ProgressBar fx:id="player1HpBar" progress="1.0"
                                     prefWidth="370" prefHeight="32"
                                     styleClass="progress-bar pixel-hp-bar pixel-hp-p1"/>
                        <Label fx:id="player1HpLabel" text="200 / 200"
                               styleClass="pixel-font"
                               style="-fx-text-fill: #a0a0c0; -fx-font-size: 14px; -fx-font-weight: bold; -fx-effect: dropshadow(one-pass-box, rgba(0,0,0,0.8), 0, 0.0, 1, 1);"/>
                    </VBox>

                    <!-- Timer Center -->
                    <VBox alignment="CENTER" spacing="1" minWidth="90">
                        <Label text="⏳" style="-fx-font-size: 12px;"/>
                        <Label fx:id="timerLabel" text="30"
                               styleClass="pixel-font"
                               style="-fx-text-fill: #e2b96f;
                                      -fx-font-size: 42px;
                                      -fx-font-weight: bold;
                                      -fx-effect: dropshadow(one-pass-box, rgba(0,0,0,0.9), 0, 0.0, 1, 2);"/>
                        <Label fx:id="turnLabel" text="Player's Turn"
                               styleClass="pixel-font"
                               style="-fx-text-fill: #a0a0c0; -fx-font-size: 10px;
                                      -fx-effect: dropshadow(one-pass-box, rgba(0,0,0,0.8), 0, 0.0, 1, 1);"/>
                    </VBox>

                    <!-- AI HP -->
                    <VBox alignment="CENTER_RIGHT" spacing="3" HBox.hgrow="ALWAYS">
                        <Label fx:id="player2NameLabel" text="AI 🤖"
                               styleClass="pixel-font"
                               style="-fx-text-fill: #7eb8e2;
                                      -fx-font-size: 18px;
                                      -fx-font-weight: bold;
                                      -fx-effect: dropshadow(one-pass-box, rgba(0,0,0,0.95), 0, 0.0, 2, 2);"/>
                        <ProgressBar fx:id="player2HpBar" progress="1.0"
                                     prefWidth="370" prefHeight="32"
                                     scaleX="-1"
                                     styleClass="progress-bar pixel-hp-bar pixel-hp-p2"/>
                        <Label fx:id="player2HpLabel" text="200 / 200"
                               styleClass="pixel-font"
                               style="-fx-text-fill: #a0a0c0; -fx-font-size: 14px; -fx-font-weight: bold; -fx-effect: dropshadow(one-pass-box, rgba(0,0,0,0.8), 0, 0.0, 1, 1);"/>
                    </VBox>

                </HBox>

                <!-- Centered Flat Battle Log (Displays only latest action) -->
                <ListView fx:id="battleLog"
                          prefWidth="700" prefHeight="38"
                          minWidth="700" minHeight="38"
                          maxWidth="700" maxHeight="38"
                          mouseTransparent="true"
                          focusTraversable="false"
                          styleClass="battle-log-flat">
                    <VBox.margin>
                        <Insets top="20" bottom="5"/>
                    </VBox.margin>
                </ListView>

            </VBox>
        </top>


        <!-- CENTER: Arena -->
        <center>
            <HBox alignment="CENTER" spacing="10"
                  style="-fx-padding: 10;">

                <!-- Player 1 Wizard Portrait -->
                <VBox alignment="BOTTOM_CENTER" spacing="8" prefWidth="180" translateY="-275" translateX="90" mouseTransparent="true">
                    <padding>
                        <Insets top="4" right="4" bottom="4" left="4"/>
                    </padding>
                    <StackPane fx:id="wizard1Portrait" prefWidth="120" prefHeight="160"
                               style="-fx-background-color: transparent;"/>
                    <Label fx:id="wizard1NameTag" text="" visible="false" managed="false"/>
                </VBox>

                <!-- Center: Grid + Word + Buttons -->
                <VBox alignment="BOTTOM_CENTER" spacing="10" HBox.hgrow="ALWAYS" style="-fx-padding: 0 0 10 0;">

                    <!-- Skill Check Status -->
                    <Label fx:id="skillCheckStatusLabel" text=""
                           style="-fx-text-fill: #ff6b6b;
                                  -fx-font-size: 13px;
                                  -fx-font-weight: bold;"/>

                    <!-- Selected Word Display (above grid) -->
                    <HBox alignment="CENTER" spacing="5" minHeight="70" translateY="-100">
                        <VBox.margin>
                            <Insets bottom="-8"/>
                        </VBox.margin>
                        <Label fx:id="selectedWordLabel" text=""
                               style="-fx-text-fill: #e2b96f;
                                      -fx-font-size: 20px;
                                      -fx-font-weight: bold;
                                      -fx-font-family: 'Pixelify Sans';"/>
                    </HBox>

                    <Label fx:id="feedbackLabel" text="" visible="false" managed="false"/>

                    <!-- Letter Grid -->
                    <GridPane fx:id="letterGridPane"
                              alignment="CENTER"
                              hgap="1" vgap="1"
                              maxWidth="253" maxHeight="253"
                              style="-fx-background-color: #000000; -fx-padding: 1;">
                    </GridPane>

                    <!-- Action Buttons -->
                    <HBox alignment="CENTER" spacing="10">
                        <Button text="↺ Clear"
                                onAction="#onClearClicked"
                                styleClass="action-btn-secondary"/>
                        <Button fx:id="castButton" text="✨ Cast!"
                                onAction="#onCastClicked"
                                styleClass="action-btn-primary"/>
                        <Button text="🔀 Shuffle"
                                onAction="#onShuffleClicked"
                                styleClass="action-btn-secondary"/>
                    </HBox>

                    <!-- Battle Log -->


                </VBox>

                <!-- Player 2 (AI) Wizard Portrait -->
                <VBox alignment="BOTTOM_CENTER" spacing="8" prefWidth="180" translateY="-275" translateX="-90" mouseTransparent="true">
                    <padding>
                        <Insets top="4" right="4" bottom="4" left="4"/>
                    </padding>
                    <StackPane fx:id="wizard2Portrait" prefWidth="120" prefHeight="160"
                               style="-fx-background-color: transparent;"/>
                    <Label fx:id="wizard2NameTag" text="" visible="false" managed="false"/>
                </VBox>

            </HBox>
        </center>

    </BorderPane>

    <!-- Last Stand Overlay — on top of everything -->
    <StackPane fx:id="lastStandOverlay"
               visible="false"
               style="-fx-background-color: #000000;"
               opacity="0.88">

        <VBox alignment="CENTER" spacing="20"
              style="-fx-padding: 40;">

            <Label text="⚠ LAST STAND ⚠"
                   style="-fx-text-fill: #ff6b6b;
                          -fx-font-size: 32px;
                          -fx-font-weight: bold;
                          -fx-font-family: 'Pixelify Sans';"/>

            <Label text="Unscramble the word to survive!"
                   style="-fx-text-fill: #a0a0c0; -fx-font-size: 14px;"/>

            <Label fx:id="scrambledWordLabel" text="??????"
                   style="-fx-text-fill: #e2b96f;
                          -fx-font-size: 48px;
                          -fx-font-weight: bold;
                          -fx-font-family: 'Pixelify Sans';"/>

            <Label fx:id="lastStandTimerLabel" text="15"
                   style="-fx-text-fill: #ff6b6b;
                          -fx-font-size: 28px;
                          -fx-font-weight: bold;"/>

            <TextField fx:id="lastStandInput"
                       promptText="Type the unscrambled word..."
                       prefWidth="320"
                       style="-fx-background-color: #2a2a4a;
                              -fx-text-fill: white;
                              -fx-prompt-text-fill: #666688;
                              -fx-border-color: #e2b96f;
                              -fx-border-radius: 5;
                              -fx-background-radius: 5;
                              -fx-font-size: 20px;
                              -fx-padding: 10;"/>

            <Label fx:id="lastStandFeedbackLabel" text=""
                   style="-fx-font-size: 13px; -fx-text-fill: #a0a0c0;"/>

        </VBox>
    </StackPane>

</StackPane>
