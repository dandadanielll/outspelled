<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import java.net.URL?>

<VBox xmlns="http://javafx.com/javafx"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.rst.outspelled.ui.MenuController"
      alignment="CENTER"
      spacing="0"
      styleClass="profile-root"
      prefWidth="900"
      prefHeight="650">

    <stylesheets>
        <URL value="@../../../assets/style.css" />
    </stylesheets>

    <!-- TOP SPACER FOR VERTICAL CENTERING -->
    <Region VBox.vgrow="ALWAYS" />

    <!-- TITLE -->
    <VBox alignment="CENTER" spacing="4" style="-fx-padding: 26 0 20 0;">
        <Label text="OutSpelled"
               styleClass="pixel-font"
               style="-fx-font-size: 86px;
                      -fx-font-weight: bold;
                      -fx-text-fill: #e2b96f;
                      -fx-effect: dropshadow(three-pass-box, #000000, 14, 0.9, 0, 3);" />
        <Label text="— A Wizard Dueling Word Game —"
               styleClass="pixel-font"
               style="-fx-font-size: 20px;
                      -fx-text-fill: #8899aa;
                      -fx-effect: dropshadow(three-pass-box, #000000, 6, 0.8, 0, 2);" />
    </VBox>

    <!-- Decorative divider -->
    <Region prefHeight="14" />
    <HBox alignment="CENTER" spacing="0">
        <Region prefWidth="160" minHeight="2" maxHeight="2" prefHeight="2" style="-fx-background-color: #e2b96f; -fx-opacity: 0.7;"/>
        <Label text="✦" styleClass="pixel-font"
               style="-fx-text-fill: #e2b96f; -fx-font-size: 14px; -fx-padding: 0 8; -fx-opacity: 1.0; -fx-effect: dropshadow(three-pass-box, rgba(226, 185, 111, 0.3), 4, 0.5, 0, 0);"/>
        <Region prefWidth="160" minHeight="2" maxHeight="2" prefHeight="2" style="-fx-background-color: #e2b96f; -fx-opacity: 0.7;"/>
    </HBox>
    <Region prefHeight="12" />

    <!-- PRIMARY BUTTONS — injected by controller -->
    <VBox fx:id="primaryButtonsBox" alignment="CENTER" spacing="12" />

    <Region prefHeight="16" />

    <!-- Divider -->
    <HBox alignment="CENTER">
        <Region prefWidth="120" prefHeight="1" style="-fx-background-color: #1e2335;"/>
    </HBox>

    <Region prefHeight="12" />

    <!-- SECONDARY BUTTONS — injected by controller -->
    <VBox fx:id="secondaryButtonsBox" alignment="CENTER" spacing="10" />

    <!-- QUIT — plain text link style, injected -->
    <StackPane fx:id="quitButtonContainer" style="-fx-padding: 10 0 0 0;" />

    <Region VBox.vgrow="ALWAYS" />

    <!-- Window mode at bottom -->
    <HBox alignment="CENTER" spacing="10" style="-fx-padding: 0 0 12 0;">
        <Label text="Window:"
               styleClass="pixel-font"
               style="-fx-text-fill: #8899aa; -fx-font-size: 11px;"/>
        <ComboBox fx:id="windowModeCombo"
                  style="-fx-background-color: #0d0f18;
                         -fx-border-color: #2a3050;
                         -fx-border-width: 1px;
                         -fx-text-fill: #506275;
                         -fx-font-family: 'Pixelify Sans';
                         -fx-font-size: 11px;"
                  prefWidth="150" />
    </HBox>

    <Label fx:id="errorLabel" text=""
           styleClass="pixel-font"
           style="-fx-text-fill: #ff6b6b; -fx-font-size: 11px; -fx-padding: 0 0 12 0;
                  -fx-min-height: 16px; -fx-pref-height: 16px;" />

</VBox>
